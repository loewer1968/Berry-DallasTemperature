# --- this script is processed, before components are created

# --- gpioForOneWire=16 is predefined and can be adjusted at this place

gpioForOneWire = 5

# Up to 8 OneWire pins can be configured here.
oneWirePins = [4, 5]

# MQTT root and debug mode are configured in configure01.be.
mqttTopicRoot = "saar159/sensors"
